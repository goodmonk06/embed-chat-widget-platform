{
  "name": "cocoon-chat-widget-platform",
  "version": "1.0.0",
  "description": "Embeddable AI chat widget platform",
  "private": true,
  "workspaces": [
    "backend",
    "widget",
    "admin"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend & npm run dev --workspace=admin",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:widget": "npm run dev --workspace=widget",
    "dev:admin": "npm run dev --workspace=admin",
    "build": "npm run build:backend && npm run build:widget && npm run build:admin",
    "build:backend": "npm run build --workspace=backend",
    "build:widget": "npm run build --workspace=widget",
    "build:admin": "npm run build --workspace=admin",
    "test": "npm run test --workspace=backend",
    "test:watch": "npm run test:watch --workspace=backend",
    "lint": "npm run lint --workspace=backend",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:push": "npm run db:push --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:rebuild": "docker compose up -d --build"
  },
  "keywords": ["chat", "widget", "embeddable", "ai"],
  "author": "",
  "license": "MIT"
}
